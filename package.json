{
  "name": "strapi-plugin-supertext-translation",
  "version": "0.1.0",
  "description": "Supertext AI translation for Strapi 5: translate entries into other locales from the Content Manager.",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "i18n",
    "translation",
    "localization",
    "supertext",
    "ai"
  ],
  "license": "MIT",
  "author": "Supertext AG <info@supertext.com>",
  "homepage": "https://github.com/Supertext/Strapi-Supertext-Translation",
  "repository": {
    "type": "git",
    "url": "https://github.com/Supertext/Strapi-Supertext-Translation.git"
  },
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test:ts:front": "tsc -p admin/tsconfig.json",
    "test:ts:back": "tsc -p server/tsconfig.json",
    "test": "vitest run",
    "pack:demo": "npm run build && npm pack --pack-destination demo && mv demo/strapi-plugin-supertext-translation-*.tgz demo/plugin.tgz",
    "mock": "node test/mock-supertext.mjs",
    "demo:install": "npm run pack:demo && cd demo && npm install ./plugin.tgz --no-audit --no-fund"
  },
  "dependencies": {
    "node-html-parser": "^9.0.4"
  },
  "devDependencies": {
    "@strapi/strapi": "^5.56.0",
    "@strapi/sdk-plugin": "^6.1.1",
    "prettier": "^3.9.9",
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "react-intl": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "styled-components": "^6.5.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@strapi/typescript-utils": "^5.56.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.56.0",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "react-intl": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "styled-components": "^6.5.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "supertext",
    "displayName": "Supertext",
    "description": "Translate entries into other locales with Supertext AI."
  }
}
