# Copy to demo/.env for local development. Railway sets these as service variables.
APP_KEYS=change-me-1,change-me-2,change-me-3,change-me-4
ADMIN_JWT_SECRET=change-me
API_TOKEN_SALT=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# Mock API (npm run mock) — replace with a real key and remove the endpoint to use Supertext
# Account: https://www.supertext.com/person/en/account/signin
# API key: https://www.supertext.com/en/integrations/api (supertext.com → Integrations → API, requires the Admin role)
SUPERTEXT_API_KEY=test-key
SUPERTEXT_API_ENDPOINT=http://127.0.0.1:8765/v1/

# Leave DATABASE_URL unset to use SQLite in demo/.tmp/data.db
# DATABASE_URL=postgres://user:pass@localhost:5432/strapi

# Optional: create accounts on startup (existing accounts are left unchanged)
# DEMO_ADMIN_EMAIL=you@example.com
# DEMO_ADMIN_PASSWORD=ChangeMe123
# DEMO_EDITOR_EMAIL=editor@example.com
# DEMO_EDITOR_PASSWORD=ChangeMe123
